{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@crm/types": ["packages/types/src/index.ts"],
      "@crm/types/*": ["packages/types/src/*"],
      "@crm/config": ["packages/config/src/index.ts"],
      "@crm/config/*": ["packages/config/src/*"],
      "@crm/validation": ["packages/validation/src/index.ts"],
      "@crm/validation/*": ["packages/validation/src/*"],
      "@crm/database": ["packages/database/src/index.ts"],
      "@crm/database/*": ["packages/database/src/*"],
      "@crm/auth": ["packages/auth/src/index.ts"],
      "@crm/auth/*": ["packages/auth/src/*"],
      "@crm/logger": ["packages/logger/src/index.ts"],
      "@crm/logger/*": ["packages/logger/src/*"],
      "@crm/storage": ["packages/storage/src/index.ts"],
      "@crm/storage/*": ["packages/storage/src/*"],
      "@crm/utils": ["packages/utils/src/index.ts"],
      "@crm/utils/*": ["packages/utils/src/*"],
      "@crm/ui": ["packages/ui/src/index.ts"],
      "@crm/ui/*": ["packages/ui/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", ".next", "build", "coverage"]
}
