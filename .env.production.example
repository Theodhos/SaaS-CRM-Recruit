#####################################################################################################
# Recruitment CRM — PRODUCTION environment template (docker-compose.prod.yml)
#
#   cp .env.production.example .env.production      # then fill in real values
#
# NEVER commit .env.production (it is git-ignored). Prefer injecting these from a secrets manager
# (see docs/operations/secrets.md): the values below are what the CONTAINERS receive.
# Generate secrets with:  openssl rand -base64 48
#####################################################################################################

# ---------- General ----------
NODE_ENV=production
APP_NAME=recruitment-crm
LOG_LEVEL=info

# ---------- Public URLs ----------
# The browser-visible origin of the platform (what users type). The edge serves web, /api and /socket.io on it.
PUBLIC_URL=https://app.example.com
# NEXT_PUBLIC_* are INLINED INTO THE BROWSER BUNDLE AT BUILD TIME (docker build args), not read at runtime.
NEXT_PUBLIC_API_URL=https://app.example.com/api/v1
NEXT_PUBLIC_REALTIME_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com
# Website origins allowed to POST applications to /api/v1/public/applications (default *: any; it carries no cookies).
PUBLIC_APPLICATIONS_ORIGINS=https://www.example.com
API_URL=https://app.example.com
API_GLOBAL_PREFIX=api/v1

# ---------- Image registry / tags (docker-compose.prod.yml, deploy.sh) ----------
REGISTRY=ghcr.io/your-org/your-repo
BLUE_TAG=latest
GREEN_TAG=latest
WORKER_TAG=latest
MIGRATE_TAG=latest
EDGE_PORT=80

# ---------- Replicas ----------
API_REPLICAS=2
WEB_REPLICAS=2
WORKER_REPLICAS=2
WORKER_CONCURRENCY=5

# ---------- PostgreSQL ----------
# Production: a MANAGED PostgreSQL (backups, PITR, replication, patching). Use its POOLED endpoint.
# connection_limit is PER API REPLICA: total connections = replicas x connection_limit (+ workers). Keep the
# total below the server's max_connections (or behind PgBouncer / Supavisor in transaction mode).
DATABASE_URL=postgresql://crm_app:CHANGE_ME@db.example.com:5432/crm?schema=recruitment_crm&connection_limit=10&pool_timeout=20&sslmode=require
# Direct (non-pooled) connection: for migrations and the backup/verify scripts.
DIRECT_DATABASE_URL=postgresql://crm_migrator:CHANGE_ME@db.example.com:5432/crm?schema=recruitment_crm&sslmode=require
# Only for the `local-db` compose profile (staging / single host):
POSTGRES_DB=recruitment_crm
POSTGRES_USER=crm_user
POSTGRES_PASSWORD=CHANGE_ME
# Read-only role in the pg_monitor group, used by postgres-exporter (observability overlay).
POSTGRES_EXPORTER_DSN=postgresql://exporter:CHANGE_ME@db.example.com:5432/postgres?sslmode=require

# ---------- Redis ----------
# Two instances on purpose: `redis` holds the BullMQ queues (must never evict), `redis-cache` holds the cache and
# rate-limit counters (evicts under memory pressure). One eviction policy cannot serve both.
REDIS_PASSWORD=CHANGE_ME
REDIS_URL=redis://:CHANGE_ME@redis:6379
REDIS_CACHE_URL=redis://:CHANGE_ME@redis-cache:6379
REDIS_MAXMEMORY=512mb
REDIS_CACHE_MAXMEMORY=512mb
# Reconnect with backoff after a Redis restart instead of giving up (see docs/operations/caching.md).
REDIS_COMMAND_TIMEOUT_MS=200
REDIS_CONNECT_TIMEOUT_MS=1000

# ---------- Scalability switches (all default to today's single-instance behaviour when unset) ----------
# Number of proxy hops in front of the API (the edge = 1). Without it every user shares one rate-limit bucket.
TRUST_PROXY=1
# Rate-limit counters shared by ALL API replicas (instead of per-process memory).
THROTTLER_STORAGE=redis
# Run each @Cron sweep on ONE replica per tick (instead of every replica).
SCHEDULER_LOCK=redis
# Cache-aside for the dashboard / report aggregates. Writes through the API invalidate at once; TTL bounds
# staleness for anything that bypasses the API.
CACHE_ENABLED=true
CACHE_TTL_SECONDS=30
# Readiness fails (LB drains the replica) if Redis is unreachable. Leave false if you run without Redis.
HEALTH_REQUIRE_REDIS=false
# Let the LB take a replica out of rotation before it stops serving (must be >= the LB health-check interval).
SHUTDOWN_DRAIN_MS=5000
# Longer than the proxy's idle timeout (nginx: 65 s) to avoid sporadic 502s on reused connections.
KEEP_ALIVE_TIMEOUT_MS=65000

# ---------- Observability ----------
# /metrics is disabled (404) unless a token is set. Same value as secrets/metrics_token (Prometheus scrapes with it).
METRICS_TOKEN=CHANGE_ME
# Per-statement DB latency histogram, and a WARN log (SQL text only — never bound values) above this many ms.
DB_QUERY_METRICS=true
DB_SLOW_QUERY_MS=500
GRAFANA_PORT=3001

# ---------- Auth ----------
JWT_ACCESS_SECRET=CHANGE_ME
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME
JWT_REFRESH_EXPIRES_IN=7d
SESSION_SECRET=CHANGE_ME
COOKIE_DOMAIN=example.com
COOKIE_SECURE=true
PASSWORD_SALT_ROUNDS=12

# ---------- File storage ----------
# Use S3-compatible object storage in production. `local` keeps files on ONE instance's disk, which cannot work
# with more than one API replica.
STORAGE_PROVIDER=s3
STORAGE_ENDPOINT=https://<account>.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_BUCKET=crm-documents
STORAGE_ACCESS_KEY_ID=CHANGE_ME
STORAGE_SECRET_ACCESS_KEY=CHANGE_ME
STORAGE_FORCE_PATH_STYLE=false
STORAGE_PUBLIC_URL=
STORAGE_MAX_UPLOAD_MB=25

# ---------- Email ----------
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM="Recruitment CRM <no-reply@example.com>"

# ---------- Rate limiting ----------
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120

# ---------- Backups (db-backup service, local-db profile) ----------
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400

# ---------- Feature flags ----------
CV_PARSING_ENABLED=true
