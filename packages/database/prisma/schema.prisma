// =============================================================================
// Recruitment CRM + ATS Platform — Prisma Schema
//
// Design principles (see docs/architecture/database.md for the full writeup):
// - Organisation is the tenant boundary. Nearly every model carries
//   organisationId and MUST be filtered by it at the query layer (see
//   packages/database/src/tenant + apps/api TenantGuard). This schema alone
//   does not enforce isolation — application-level enforcement is mandatory.
// - Entities carry the MINIMUM fields needed to identify and operate the
//   object. Resist adding fields "just in case" — extend later when a real
//   requirement shows up; it never breaks this structure.
// - Normal foreign keys are used everywhere a relationship has a small,
//   fixed set of possible parents (Activity, Task, CalendarEvent, Comment,
//   Document all use explicit nullable FKs, not a polymorphic
//   entityType/entityId pair). The one deliberate exception is
//   CandidateTag/Tag — see the Tag section below for why.
// - Soft delete (`deletedAt`) is used only on the handful of high-value,
//   user-facing records where losing history would hurt: Candidate,
//   Company, Contact, Job, Application. Everything else is either
//   append-only (Activity, AuditLog) or safe to hard-delete (join tables).
// - IDs use cuid() for collision-safe, sortable-ish, non-guessable keys.
// - See docs/database/relationships.md for the full ERD narrative.
// =============================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DEACTIVATED
}

enum TeamMemberRole {
  LEAD
  MEMBER
}

enum CompanyStatus {
  PROSPECT
  ACTIVE_CLIENT
  FORMER_CLIENT
  INACTIVE
}

/// Column of a company on the "Pipeline Companies" board (sales side: winning the company as a client).
enum CompanyPipelineStage {
  NEW
  IN_CONVERSATION
  WIN
  LOST
}

enum ContactStatus {
  ACTIVE
  INACTIVE
}

enum CandidateStatus {
  ACTIVE
  PASSIVE
  DO_NOT_CONTACT
  PLACED
  ARCHIVED
}

// Kept intentionally small — see JOB section in the spec: "Do not hardcode
// UI behavior around one status." New values are a migration, not a rewrite.
enum JobStatus {
  OPEN
  ON_HOLD
  CLOSED
}

enum EmploymentType {
  PERMANENT
  CONTRACT
  TEMPORARY
  PART_TIME
}

enum ApplicationStatus {
  ACTIVE
  ON_HOLD
  REJECTED
  WITHDRAWN
  PLACED
}

enum ApplicationSource {
  SOURCED
  INBOUND
  REFERRAL
  JOB_BOARD
  AGENCY
  CAREER_SITE
  OTHER
}

// PipelineStage.type — a small, code-understood classification so business
// logic (e.g. "this move should create a Placement") never has to
// string-match a stage's display name. STANDARD covers every ordinary
// working stage (New, Shortlisted, Sent, Interview, Offer, ...).
enum PipelineStageType {
  STANDARD
  PLACED
  REJECTED
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  INTERVIEW
  NOTE
  FOLLOW_UP
  STATUS_CHANGE
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum CalendarEventType {
  MEETING
  INTERVIEW
  CALL
}

enum CalendarEventStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum EmailMessageStatus {
  DRAFT
  SENT
  FAILED
}

// Shared by CandidateDocument and Document.
enum DocumentType {
  CV
  RESUME
  COVER_LETTER
  CONTRACT
  OFFER_LETTER
  OTHER
}

/// How the placed person is employed — chosen per placement, shown and filterable on Active Employees.
enum PlacementEmploymentType {
  PERMANENT
  TEMPORARY
}

enum PlacementStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum FeeStatus {
  PENDING
  INVOICED
  PAID
  OVERDUE
  CANCELLED
}

enum RetainerStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum RenewalStatus {
  PENDING
  RENEWED
  LAPSED
  CANCELLED
}

enum IntegrationStatus {
  CONNECTED
  DISCONNECTED
  ERROR
  PENDING_SETUP
}

// =============================================================================
// TENANCY, IDENTITY, RBAC
// =============================================================================

model Organisation {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  status    String   @default("ACTIVE") // ACTIVE | TRIAL | SUSPENDED
  /// The organisation's own settings, e.g. `payDefaults` (see OrganisationsService).
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users               User[]
  roles               Role[]
  teams               Team[]
  companies           Company[]
  contacts            Contact[]
  candidates          Candidate[]
  candidateDocuments  CandidateDocument[]
  tags                Tag[]
  jobs                Job[]
  pipelines           Pipeline[]
  applications        Application[]
  applicationStageNotes ApplicationStageNote[]
  activities          Activity[]
  tasks               Task[]
  calendarEvents      CalendarEvent[]
  interviews          Interview[]
  emailThreads        EmailThread[]
  documents           Document[]
  comments            Comment[]
  talentPools         TalentPool[]
  distributionLists   DistributionList[]
  placements          Placement[]
  fees                Fee[]
  retainers           Retainer[]
  renewals            Renewal[]
  notifications       Notification[]
  reports             Report[]
  userEngagementEvents UserEngagementEvent[]
  auditLogs           AuditLog[]
  integrations        Integration[]
  phones              Phone[]
  phoneCalls          PhoneCall[]
  phoneImports        PhoneImport[]

  @@map("organisations")
}

enum LoginChallengeStatus {
  PENDING
  VERIFIED
  EXPIRED
  CANCELLED
}

/// Second step of every login: the password was right, and a one-time code was e-mailed. The session is issued only
/// when the code is confirmed. Neither the code nor the browser's challenge token is stored — only their hashes.
/// Not tenant-scoped, like the rest of authentication (see AuthRepository): it exists before a session does.
model LoginChallenge {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 of the opaque token the browser holds in an httpOnly cookie.
  tokenHash String @unique
  /// HMAC-SHA256 of the 6-digit code.
  codeHash  String
  status    LoginChallengeStatus @default(PENDING)

  /// When the current code stops being accepted (5 minutes after it was sent).
  expiresAt   DateTime
  /// When the whole challenge ends, however many codes were sent.
  closesAt    DateTime
  attempts    Int      @default(0)
  maxAttempts Int      @default(5)
  sendCount   Int      @default(1)
  lastSentAt  DateTime @default(now())
  verifiedAt  DateTime?

  requestIp String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, status])
  @@index([expiresAt])
  @@map("login_challenges")
}

/// A "choose a new password" link that was e-mailed. Good once, for 30 minutes; only the hash of its token is kept.
model PasswordReset {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  requestIp String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("password_resets")
}

model User {
  id             String   @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  firstName    String
  lastName     String
  email        String
  passwordHash String
  avatarUrl    String?
  status       UserStatus @default(INVITED)

  /// The pages of the CRM this user works with, chosen by the admin (the sidebar paths, e.g. "/pipeline").
  /// Empty = every page a member may use. Admins always see everything.
  allowedSections String[] @default([])

  /// Sign-in asks this user for a code sent to their e-mail, after the password (set by the admin).
  loginOtpEnabled Boolean @default(false)

  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teamMemberships TeamMember[]
  loginChallenges LoginChallenge[]
  passwordResets  PasswordReset[]

  ownedCompanies    Company[]     @relation("CompanyOwner")
  ownedContacts     Contact[]     @relation("ContactOwner")
  ownedCandidates   Candidate[]   @relation("CandidateOwner")
  ownedJobs         Job[]         @relation("JobOwner")
  ownedApplications Application[] @relation("ApplicationOwner")
  ownedTalentPools  TalentPool[]  @relation("TalentPoolOwner")
  ownedDistributionLists DistributionList[] @relation("DistributionListOwner")
  ownedPlacements   Placement[]   @relation("PlacementOwner")

  assignedTasks Task[] @relation("TaskAssignee")
  createdTasks  Task[] @relation("TaskCreator")

  calendarEvents CalendarEvent[] @relation("CalendarEventOwner")
  activities     Activity[]      @relation("ActivityUser")
  interviews     Interview[]     @relation("InterviewInterviewer")
  phones         Phone[]         @relation("PhoneOwner")
  phoneCalls     PhoneCall[]     @relation("PhoneCallAgent")
  phoneImports   PhoneImport[]   @relation("PhoneImportUser")

  uploadedDocuments          Document[]          @relation("DocumentUploader")
  uploadedCandidateDocuments CandidateDocument[]  @relation("CandidateDocumentUploader")
  comments                   Comment[]           @relation("CommentAuthor")

  taggedCandidateTags          CandidateTag[]            @relation("CandidateTagTaggedBy")
  addedTalentPoolMembers       TalentPoolMember[]        @relation("TalentPoolMemberAddedBy")
  addedDistributionListMembers DistributionListMember[]  @relation("DistributionListMemberAddedBy")

  reportsCreated        Report[]      @relation("ReportCreatedBy")
  integrationsConnected Integration[] @relation("IntegrationConnectedBy")

  notifications        Notification[]
  auditLogs             AuditLog[]
  userEngagementEvents  UserEngagementEvent[]

  @@unique([organisationId, email])
  @@index([organisationId])
  // Login looks a user up by e-mail alone (before the organisation is known), which the unique above cannot serve.
  @@index([email])
  @@map("users")
}

// Simple RBAC: one Role per User (no many-to-many), a Role is a named
// bundle of Permissions via RolePermission. See docs/architecture/authorization.md.
model Role {
  id             String   @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  name        String // e.g. "Admin", "Recruiter", "Manager", "Consultant", "Viewer"
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  rolePermissions RolePermission[]

  @@unique([organisationId, name])
  @@index([organisationId])
  @@map("roles")
}

// Global, code-defined permission catalog (e.g. "candidate:create"). Not
// organisation-scoped — new permissions ship via migration/seed, never
// hand-authored per tenant.
model Permission {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. "candidate:create"
  module      String   // e.g. "candidates"
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model Team {
  id             String   @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members TeamMember[]

  @@index([organisationId])
  @@map("teams")
}

model TeamMember {
  id       String         @id @default(cuid())
  teamId   String
  team     Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId   String
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     TeamMemberRole @default(MEMBER)
  joinedAt DateTime       @default(now())

  @@unique([teamId, userId])
  @@map("team_members")
}

// =============================================================================
// COMPANIES & CONTACTS
// =============================================================================

model Company {
  id             String   @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  name     String
  industry String?
  website  String?
  email    String?
  phone    String?
  address  String?
  city     String?
  country  String?
  status   CompanyStatus @default(PROSPECT)

  pipelineStage CompanyPipelineStage @default(NEW)

  /// Free text about the company: where it operates, the services it offers, anything worth knowing.
  about String?

  /// What the Pipeline Companies pop-up keeps: { stages: { NEW: { notes, updatedAt, enteredAt }, … }, pay: { … } } —
  /// the shape lives in the API (modules/companies/service/pipeline-record.ts).
  pipelineRecord Json @default("{}")

  ownerId String?
  owner   User?   @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  contacts       Contact[]
  jobs           Job[]
  activities     Activity[]
  tasks          Task[]
  phones         Phone[]
  calendarEvents CalendarEvent[]
  emailThreads   EmailThread[]
  documents      Document[]
  comments       Comment[]
  placements     Placement[]
  retainers      Retainer[]
  candidates     Candidate[]

  @@index([organisationId])
  @@index([organisationId, status])
  @@index([ownerId])
  @@map("companies")
}

model Contact {
  id             String   @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  firstName String
  lastName  String
  email     String?
  phone     String?
  jobTitle  String?
  status    ContactStatus @default(ACTIVE)

  ownerId String?
  owner   User?   @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  activities              Activity[]
  tasks                   Task[]
  phones                  Phone[]
  calendarEvents          CalendarEvent[]
  emailThreads            EmailThread[]
  documents               Document[]
  comments                Comment[]
  distributionListMembers DistributionListMember[]

  @@index([organisationId])
  @@index([organisationId, createdAt(sort: Desc)])
  @@index([companyId])
  @@index([ownerId])
  @@map("contacts")
}

// =============================================================================
// CANDIDATES
// =============================================================================

model Candidate {
  id             String   @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  firstName      String
  lastName       String
  email          String?
  phone          String?
  location       String?
  jobTitle       String?
  currentCompany String?
  source         String?
  avatarUrl      String?
  status         CandidateStatus @default(ACTIVE)

  ownerId String?
  owner   User?   @relation("CandidateOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  // The specific open Job this candidate is being considered for, set while
  // they're still raw/unassigned (no Application yet) — what lets the
  // potential-ranking compare candidates against each other for the SAME
  // job, not just score each one in isolation. Independent of Application:
  // once "Add to pipeline" is clicked this stops mattering (the Application
  // carries its own jobId from here on), so it's never required.
  interestedJobId String?
  interestedJob   Job?    @relation("CandidateInterestedJob", fields: [interestedJobId], references: [id], onDelete: SetNull)

  // Employer named in `currentCompany` (free text — from manual entry or CV
  // scan), resolved to a Companies row by name match, auto-creating one if
  // none exists yet. Optional and independent of `currentCompany`: this is
  // a best-effort CRM link, not a guarantee the text and relation agree.
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  applications      Application[]
  documents         CandidateDocument[]
  legalDocuments    Document[]          @relation("CandidateLegalDocument")
  activities        Activity[]
  tasks             Task[]
  calendarEvents    CalendarEvent[]
  phones            Phone[]
  candidateTags     CandidateTag[]
  talentPoolMembers TalentPoolMember[]
  placements        Placement[]
  emailThreads      EmailThread[]
  comments          Comment[]

  @@index([organisationId])
  @@index([organisationId, status])
  // List pages (`WHERE organisationId = ? AND deletedAt IS NULL ORDER BY createdAt DESC LIMIT n`): walk the index
  // in order and stop after n rows instead of scanning + sorting the whole tenant. Measured at 1M rows: ~500 ms -> ~0 ms.
  @@index([organisationId, createdAt(sort: Desc)])
  @@index([organisationId, status, createdAt(sort: Desc)])
  @@index([organisationId, email])
  @@index([ownerId])
  @@index([companyId])
  @@index([interestedJobId])
  @@map("candidates")
}

// PostgreSQL stores metadata only — the file itself lives in S3-compatible
// object storage behind packages/storage's StorageProvider abstraction.
// `fileUrl` holds the storage key/path resolved through that abstraction,
// not a public URL.
model CandidateDocument {
  id             String   @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  name     String
  type     DocumentType @default(CV)
  fileUrl  String
  fileSize Int

  uploadedById String?
  uploadedBy   User?   @relation("CandidateDocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([organisationId])
  @@index([candidateId])
  @@map("candidate_documents")
}

// The one deliberate polymorphic-adjacent exception in this schema: tagging
// is a single, identical capability (attach a label) that four unrelated
// entities need. Four near-duplicate join tables (CandidateTag, CompanyTag,
// ContactTag, JobTag) would be pure boilerplate with zero behavioral
// difference between them. Phase 1 implements CandidateTag only (the case
// actually needed now); Tag itself is generic so CompanyTag/ContactTag/
// JobTag can be added later as plain, ordinary join tables — see
// docs/decisions for the full reasoning.
model Tag {
  id             String   @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  name      String
  createdAt DateTime @default(now())

  candidateTags CandidateTag[]

  @@unique([organisationId, name])
  @@index([organisationId])
  @@map("tags")
}

model CandidateTag {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  tagId       String
  tag         Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  taggedById String?
  taggedBy   User?   @relation("CandidateTagTaggedBy", fields: [taggedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([candidateId, tagId])
  @@map("candidate_tags")
}

// =============================================================================
// JOBS
// =============================================================================

model Job {
  id             String   @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  // Optional: a Job can be created before its Company is known (or matched
  // by name at creation time, same as Candidate.companyId) — SetNull rather
  // than Cascade so an unlinked/later-linked Company can be deleted without
  // silently deleting the Job it was never really tied to.
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  title          String
  /// What the job is — the role in plain words.
  description    String?
  /// What the candidate will do in the job, one duty per line.
  responsibilities String?
  /// What the job asks of the candidate (skills, qualifications, licences), one requirement per line.
  requirements   String?
  /// Years of experience the job asks for; max is null for "at least min".
  experienceYearsMin Int?
  experienceYearsMax Int?
  location       String?
  employmentType EmploymentType @default(PERMANENT)
  salaryMin      Decimal?       @db.Decimal(12, 2)
  salaryMax      Decimal?       @db.Decimal(12, 2)
  currency       String         @default("USD")
  /// The pay package beyond the salary range: bonus, benefits, allowances, leave — one item per line.
  compensationPackage String?
  status         JobStatus      @default(OPEN)

  ownerId String?
  owner   User?   @relation("JobOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  openedAt  DateTime  @default(now())
  closedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  applications        Application[]
  activities          Activity[]
  tasks               Task[]
  calendarEvents      CalendarEvent[]
  documents           Document[]
  comments            Comment[]
  placements          Placement[]
  interestedCandidates Candidate[] @relation("CandidateInterestedJob")

  @@index([organisationId])
  @@index([organisationId, status])
  @@index([organisationId, createdAt(sort: Desc)])
  @@index([companyId])
  @@index([ownerId])
  @@map("jobs")
}

// =============================================================================
// ATS PIPELINE: CANDIDATE -> APPLICATION -> JOB
// =============================================================================

// Pipelines and stages are organisation-configurable. Never hard-code stage
// names/order in application code — always resolve via PipelineStage.
model Pipeline {
  id             String   @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  name        String
  description String?
  /// What a candidate becomes when they reach this scheme's "Placed" stage: a permanent or a temporary employee
  /// (the Placement created automatically inherits it — see ApplicationsService.maybeAutoPlace).
  employmentType PlacementEmploymentType @default(PERMANENT)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stages       PipelineStage[]
  applications Application[]

  @@index([organisationId])
  @@map("pipelines")
}

model PipelineStage {
  id         String   @id @default(cuid())
  pipelineId String
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  name      String
  order     Int
  type      PipelineStageType @default(STANDARD)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  applications Application[]
  checklistItems PipelineStageChecklistItem[]
  stageNotes     ApplicationStageNote[]

  @@unique([pipelineId, order])
  @@map("pipeline_stages")
}

// The "phase test/questions" a stage requires — a template checklist that
// every Application passing through this stage can be marked against (see
// ApplicationChecklistItem). Has no organisationId of its own, same as
// PipelineStage — tenant ownership is always proven by walking up to the
// parent Pipeline (see PipelineStagesService).
model PipelineStageChecklistItem {
  id              String        @id @default(cuid())
  pipelineStageId String
  pipelineStage   PipelineStage @relation(fields: [pipelineStageId], references: [id], onDelete: Cascade)

  label     String
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  responses ApplicationChecklistItem[]

  @@unique([pipelineStageId, order])
  @@index([pipelineStageId])
  @@map("pipeline_stage_checklist_items")
}

// THE most important relationship in the ATS: a Candidate is never linked
// to a Job directly. Application is the join, and it carries its own
// pipeline/stage/status so the same candidate can be at different stages
// of different jobs' recruitment processes at the same time.
model Application {
  id             String   @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  pipelineId String
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Restrict)

  pipelineStageId String
  pipelineStage   PipelineStage @relation(fields: [pipelineStageId], references: [id], onDelete: Restrict)

  status ApplicationStatus @default(ACTIVE)
  source ApplicationSource @default(OTHER)

  ownerId String?
  owner   User?   @relation("ApplicationOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  appliedAt DateTime  @default(now())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  activities     Activity[]
  tasks          Task[]
  calendarEvents CalendarEvent[]
  interviews     Interview[]
  documents      Document[]
  comments       Comment[]
  checklistResponses ApplicationChecklistItem[]

  stageNotes ApplicationStageNote[]
  @@unique([candidateId, jobId])
  @@index([organisationId])
  @@index([organisationId, status])
  // Applications list is `ORDER BY appliedAt DESC LIMIT n`. Measured at 1.2M rows: ~510 ms -> ~0 ms.
  @@index([organisationId, appliedAt(sort: Desc)])
  @@index([jobId])
  @@index([pipelineStageId])
  @@index([ownerId])
  @@map("applications")
}

// One Application's completion state for one PipelineStageChecklistItem —
// the per-candidate answer to that stage's "test/question". No
// organisationId of its own; tenant ownership is proven via the Application
// (which is tenant-scoped) before this is ever touched (see
// ApplicationsService.toggleChecklistItem).
/// What was discussed with an applicant at one pipeline stage, plus the pay calculation agreed there
/// (hourly rate -> per day -> per month, and the agency fee). One row per application per stage, so the
/// history follows the applicant from stage to stage. Notes belong to the application's owner (owner scope).
model ApplicationStageNote {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  pipelineStageId String
  pipelineStage   PipelineStage @relation(fields: [pipelineStageId], references: [id], onDelete: Cascade)

  notes        String?
  hourlyRate   Decimal? @db.Decimal(10, 2)
  hoursPerDay  Int      @default(8)
  daysPerMonth Int      @default(21)
  feePercent   Decimal? @db.Decimal(5, 2)
  currency     String   @default("USD")
  /// The stage's own form (screening result, interview ratings, offer terms, rejection reason…) as key/value pairs —
  /// the field set per stage lives in the web app (features/pipelines/stage-forms.ts).
  fields       Json     @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([applicationId, pipelineStageId])
  @@index([organisationId])
  @@map("application_stage_notes")
}

model ApplicationChecklistItem {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  checklistItemId String
  checklistItem    PipelineStageChecklistItem @relation(fields: [checklistItemId], references: [id], onDelete: Cascade)

  completed   Boolean   @default(false)
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([applicationId, checklistItemId])
  @@index([applicationId])
  @@map("application_checklist_items")
}

// =============================================================================
// ACTIVITY, TASKS, CALENDAR, INTERVIEWS
// =============================================================================

// Single unified activity log. All activity kinds (calls, emails, meetings,
// status changes, etc.) live here rather than in per-type tables — see
// docs/architecture/overview.md#activity-system. An activity can be planned
// ahead (scheduledAt) and later marked done (completedAt).
model Activity {
  id             String   @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  type        ActivityType
  subject     String?
  description String?
  scheduledAt DateTime?
  completedAt DateTime?

  userId String
  user   User   @relation("ActivityUser", fields: [userId], references: [id], onDelete: Restrict)

  candidateId   String?
  candidate     Candidate?   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  companyId     String?
  company       Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId     String?
  contact       Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  jobId         String?
  job           Job?         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([organisationId])
  @@index([candidateId])
  @@index([companyId])
  @@index([contactId])
  @@index([jobId])
  @@index([applicationId])
  @@index([organisationId, createdAt])
  @@map("activities")
}

model Task {
  id             String   @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?

  // Set once the "overdue" notification has actually been sent (see
  // TasksRemindersService) — the guard against re-notifying on every cron
  // tick while it sits unfinished past its due date. Cleared whenever
  // dueDate is changed, so a rescheduled task can trigger it again later.
  overdueNotifiedAt DateTime?

  assignedToId String
  assignedTo   User   @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: Restrict)
  createdById  String
  createdBy    User   @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)

  candidateId   String?
  candidate     Candidate?   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  companyId     String?
  company       Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId     String?
  contact       Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  jobId         String?
  job           Job?         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organisationId])
  @@index([assignedToId, status])
  // Tasks list is `ORDER BY dueDate ASC, createdAt DESC LIMIT n`. Measured at 500k rows: ~440 ms -> ~0 ms.
  @@index([organisationId, dueDate, createdAt(sort: Desc)])
  @@map("tasks")
}

model CalendarEvent {
  id             String   @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  title      String
  type       CalendarEventType   @default(MEETING)
  startAt    DateTime
  endAt      DateTime
  location   String?
  meetingUrl String?
  status     CalendarEventStatus @default(SCHEDULED)

  // Set once the "starting soon" reminder notification has actually been
  // sent (see CalendarRemindersService) — the guard against re-notifying on
  // every cron tick while the event sits inside the reminder window.
  reminderSentAt DateTime?

  userId String
  user   User   @relation("CalendarEventOwner", fields: [userId], references: [id], onDelete: Restrict)

  candidateId   String?
  candidate     Candidate?   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  contactId     String?
  contact       Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  companyId     String?
  company       Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobId         String?
  job           Job?         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organisationId])
  @@index([organisationId, startAt])
  @@index([status, startAt, reminderSentAt])
  @@map("calendar_events")
}

model Interview {
  id             String   @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  scheduledAt DateTime
  duration    Int             @default(60) // minutes
  location    String?
  meetingUrl  String?
  status      InterviewStatus @default(SCHEDULED)
  notes       String?

  /// IANA time zone the slot was picked in — the e-mail and the Zoom meeting are expressed in it.
  timezone     String?
  /// Where the meeting link came from: "zoom" (created through the Zoom API) or "manual" (a pasted link).
  provider     String?
  /// Zoom's start_url for the host — never sent to the candidate.
  hostUrl      String?
  /// Set once the invitation e-mail went out, and to which address.
  inviteSentAt DateTime?
  inviteSentTo String?
  /// The interviewer's calendar entry for this slot — removed together with the interview.
  calendarEventId String?

  interviewerId String?
  interviewer   User?   @relation("InterviewInterviewer", fields: [interviewerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organisationId])
  @@index([applicationId])
  @@map("interviews")
}

// =============================================================================
// EMAIL
// =============================================================================

model EmailThread {
  id             String   @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  subject String

  candidateId String?
  candidate   Candidate? @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  contactId   String?
  contact     Contact?   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  companyId   String?
  company     Company?   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages EmailMessage[]

  @@index([organisationId])
  @@index([candidateId])
  @@index([contactId])
  @@map("email_threads")
}

// Email send/receive infrastructure is abstracted behind apps/worker's email
// processor — this table never assumes a specific provider (SMTP/SES/
// Gmail API/...). `status` tracks this row's own lifecycle (DRAFT -> SENT,
// or FAILED), not the provider's delivery status.
model EmailMessage {
  id       String      @id @default(cuid())
  threadId String
  thread   EmailThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  from    String
  to      String
  cc      String?
  subject String
  body    String
  status  EmailMessageStatus @default(DRAFT)

  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([threadId])
  @@map("email_messages")
}

// =============================================================================
// DOCUMENTS & COMMENTS
// =============================================================================

// Generic files not tied to a candidate (contracts, offer letters, company
// files, job attachments). Explicit nullable FKs per related entity — same
// pattern as Comment below — rather than a polymorphic entityType/entityId
// pair, since the set of possible parents is small and fixed.
model Document {
  id             String   @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  name     String
  type     DocumentType @default(OTHER)
  fileUrl  String
  fileSize Int

  uploadedById String?
  uploadedBy   User?   @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  companyId     String?
  company       Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId     String?
  contact       Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  jobId         String?
  job           Job?         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  candidateId   String?
  candidate     Candidate?   @relation("CandidateLegalDocument", fields: [candidateId], references: [id], onDelete: Cascade)
  placementId   String?
  placement     Placement?   @relation(fields: [placementId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organisationId])
  @@index([placementId])
  @@index([candidateId])
  @@map("documents")
}

// Same reusable comment/note architecture across every entity that needs
// it — explicit nullable FKs, exactly like Document/Activity/Task above.
model Comment {
  id             String   @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  body String

  authorId String
  author   User   @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  candidateId   String?
  candidate     Candidate?   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  companyId     String?
  company       Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId     String?
  contact       Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  jobId         String?
  job           Job?         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organisationId])
  @@map("comments")
}

// =============================================================================
// TALENT POOLS & DISTRIBUTION LISTS
// =============================================================================

model TalentPool {
  id             String   @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  name        String
  description String?

  ownerId String?
  owner   User?   @relation("TalentPoolOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members TalentPoolMember[]

  @@index([organisationId])
  @@map("talent_pools")
}

model TalentPoolMember {
  id           String     @id @default(cuid())
  talentPoolId String
  talentPool   TalentPool @relation(fields: [talentPoolId], references: [id], onDelete: Cascade)
  candidateId  String
  candidate    Candidate  @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  addedById String?
  addedBy   User?   @relation("TalentPoolMemberAddedBy", fields: [addedById], references: [id], onDelete: SetNull)
  addedAt   DateTime @default(now())

  @@unique([talentPoolId, candidateId])
  @@map("talent_pool_members")
}

model DistributionList {
  id             String   @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  name        String
  description String?

  ownerId String?
  owner   User?   @relation("DistributionListOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members DistributionListMember[]

  @@index([organisationId])
  @@map("distribution_lists")
}

model DistributionListMember {
  id                 String           @id @default(cuid())
  distributionListId String
  distributionList   DistributionList @relation(fields: [distributionListId], references: [id], onDelete: Cascade)
  contactId          String
  contact            Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)

  addedById String?
  addedBy   User?   @relation("DistributionListMemberAddedBy", fields: [addedById], references: [id], onDelete: SetNull)
  addedAt   DateTime @default(now())

  @@unique([distributionListId, contactId])
  @@map("distribution_list_members")
}

// =============================================================================
// PLACEMENTS, FEES, RETAINERS, RENEWALS (revenue)
// =============================================================================

// A successful recruitment: Candidate + Job + Company, always. Fee(s)
// against a Placement are how recruitment revenue is tracked.
model Placement {
  id             String   @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  jobId       String
  job         Job       @relation(fields: [jobId], references: [id], onDelete: Restrict)
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)

  startDate DateTime
  endDate   DateTime?
  status    PlacementStatus @default(ACTIVE)
  employmentType PlacementEmploymentType @default(PERMANENT)

  ownerId String?
  owner   User?   @relation("PlacementOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fees      Fee[]
  documents Document[]

  @@index([organisationId])
  @@index([candidateId])
  @@index([jobId])
  @@index([companyId])
  @@map("placements")
}

model Fee {
  id             String   @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  placementId String
  placement   Placement @relation(fields: [placementId], references: [id], onDelete: Cascade)

  amount   Decimal   @db.Decimal(12, 2)
  currency String    @default("USD")
  status   FeeStatus @default(PENDING)
  dueDate  DateTime?
  paidAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organisationId])
  @@index([placementId])
  @@map("fees")
}

model Retainer {
  id             String   @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  amount    Decimal        @db.Decimal(12, 2)
  currency  String         @default("USD")
  status    RetainerStatus @default(ACTIVE)
  startDate DateTime
  endDate   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  renewals Renewal[]

  @@index([organisationId])
  @@index([companyId])
  @@map("retainers")
}

model Renewal {
  id             String   @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  retainerId String
  retainer   Retainer @relation(fields: [retainerId], references: [id], onDelete: Cascade)

  renewalDate DateTime
  amount      Decimal       @db.Decimal(12, 2)
  status      RenewalStatus @default(PENDING)

  createdAt DateTime @default(now())

  @@index([organisationId])
  @@index([retainerId])
  @@map("renewals")
}

// =============================================================================
// NOTIFICATIONS
// =============================================================================

model Notification {
  id             String   @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    String // e.g. "TASK_ASSIGNED", "APPLICATION_STATUS_CHANGED", "INTERVIEW_SCHEDULED"
  title   String
  message String?
  // Where clicking this notification should take you — a relative in-app
  // path (e.g. "/tasks?taskId=…", "/candidates/…") straight to the record
  // it's about. Optional: not every notification has a single obvious
  // destination.
  link    String?
  readAt  DateTime?

  createdAt DateTime @default(now())

  @@index([organisationId])
  @@index([userId, readAt])
  // Bell list is `WHERE userId AND organisationId ORDER BY createdAt DESC LIMIT n` (~175 ms -> ~0 ms at 1M rows); the
  // unread badge (polled every 30 s per open tab) counts `readAt IS NULL` and can now be answered from the index alone.
  @@index([userId, organisationId, createdAt(sort: Desc)])
  @@index([userId, organisationId, readAt])
  @@map("notifications")
}

// =============================================================================
// REPORTS & ANALYTICS
// =============================================================================

// Saved report definitions. Dashboard metrics themselves (new jobs,
// placements, shortlisted, etc.) are NOT stored anywhere — they are
// computed on demand from Jobs/Applications/Candidates/Activities/
// Interviews/Placements. See docs/architecture/overview.md#analytics.
model Report {
  id             String   @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  name         String
  type         String
  definition   Json // query/config describing the report (filters, groupings, chart type)
  isScheduled  Boolean   @default(false)
  scheduleCron String?
  lastRunAt    DateTime?

  createdById String?
  createdBy   User?   @relation("ReportCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organisationId])
  @@map("reports")
}

// Lightweight append-only event log feeding analytics aggregation jobs
// (apps/worker/src/processors/analytics). Not the audit trail — see AuditLog.
model UserEngagementEvent {
  id             String   @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  eventType  String // e.g. "LOGIN", "VIEW_CANDIDATE", "CREATE_JOB", "MOVE_APPLICATION_STAGE"
  entityType String?
  entityId   String?

  createdAt DateTime @default(now())

  @@index([organisationId, eventType])
  @@index([organisationId, createdAt])
  @@map("user_engagement_events")
}

// =============================================================================
// AUDIT LOG
// =============================================================================

model AuditLog {
  id             String   @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Free-form action string (e.g. "CREATE_CANDIDATE", "MOVE_APPLICATION",
  // "CREATE_PLACEMENT") rather than a generic CRUD enum — some audited
  // actions (moving an application through the pipeline) are a distinct
  // business event, not just an UPDATE.
  action     String
  entityType String
  entityId   String
  oldValues  Json?
  newValues  Json?

  createdAt DateTime @default(now())

  @@index([organisationId, entityType, entityId])
  @@index([organisationId, createdAt])
  @@map("audit_logs")
}

// =============================================================================
// INTEGRATIONS
// =============================================================================

model Integration {
  id             String   @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  provider String // e.g. "gmail", "outlook", "linkedin", "job-board-x"
  status   IntegrationStatus @default(PENDING_SETUP)
  config   Json?

  connectedById String?
  connectedBy   User?   @relation("IntegrationConnectedBy", fields: [connectedById], references: [id], onDelete: SetNull)
  connectedAt   DateTime?
  lastSyncedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organisationId, provider])
  @@map("integrations")
}

// =============================================================================
// PHONES — calling lists imported from Excel/CSV, called from the browser
// =============================================================================

enum PhoneStatus {
  READY
  DO_NOT_CALL
}

enum PhoneCallDirection {
  OUTBOUND
  INBOUND
}

enum PhoneCallStatus {
  INITIATED
  RINGING
  ANSWERED
  NO_ANSWER
  BUSY
  FAILED
  REJECTED
  ENDED
}

enum PhoneImportStatus {
  PREVIEW
  RUNNING
  COMPLETED
  FAILED
}

/// A number on an instructor's calling list. The phone is the primary datum; name, e-mail and company are whatever
/// the imported file had. `normalizedPhone` (E.164) is what duplicates are detected on.
model Phone {
  id             String   @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  name            String?
  phone           String
  normalizedPhone String
  email           String?
  company         String?
  source          String?
  status          PhoneStatus @default(READY)

  /// Denormalised from the calls so the list filters (never called / answered / busy…) stay one indexed column.
  lastCallAt     DateTime?
  lastCallStatus PhoneCallStatus?
  callCount      Int              @default(0)

  ownerId String?
  owner   User?   @relation("PhoneOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  /// Best-effort links to CRM records that already existed when the file was imported (never auto-created).
  candidateId String?
  candidate   Candidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  contactId   String?
  contact     Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  companyId   String?
  companyRef  Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)

  importId String?
  import   PhoneImport? @relation(fields: [importId], references: [id], onDelete: SetNull)

  calls PhoneCall[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([organisationId, normalizedPhone])
  @@index([organisationId, lastCallStatus])
  @@index([organisationId, createdAt])
  @@index([ownerId])
  @@map("phones")
}

model PhoneCall {
  id             String   @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  phoneId String
  phone   Phone  @relation(fields: [phoneId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation("PhoneCallAgent", fields: [userId], references: [id], onDelete: Restrict)

  provider       String
  providerCallId String?            @unique
  direction      PhoneCallDirection @default(OUTBOUND)
  status         PhoneCallStatus    @default(INITIATED)

  startedAt       DateTime?
  answeredAt      DateTime?
  endedAt         DateTime?
  durationSeconds Int?
  notes           String?
  /// Sequence number of the last provider event applied — webhook processing stays idempotent and ordered.
  lastEventSeq Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organisationId])
  @@index([phoneId, createdAt])
  @@map("phone_calls")
}

model PhoneImport {
  id             String   @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  userId         String
  user           User   @relation("PhoneImportUser", fields: [userId], references: [id], onDelete: Restrict)

  fileName       String
  defaultCountry String
  status         PhoneImportStatus @default(PREVIEW)

  totalRows     Int @default(0)
  validRows     Int @default(0)
  duplicateRows Int @default(0)
  invalidRows   Int @default(0)
  importedRows  Int @default(0)
  skippedRows   Int @default(0)
  failedRows    Int @default(0)
  /// Rows that were not imported and why (capped) — the downloadable error report.
  errors Json?

  phones Phone[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  finishedAt DateTime?

  @@index([organisationId, createdAt])
  @@map("phone_imports")
}
