{
  "name": "@crm/realtime",
  "version": "0.1.0",
  "private": true,
  "description": "WebSocket (Socket.IO) gateway for live notifications, application/task/activity updates",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@crm/auth": "workspace:*",
    "@crm/config": "workspace:*",
    "@crm/logger": "workspace:*",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-socket.io": "^10.4.0",
    "@nestjs/websockets": "^10.4.0",
    "ioredis": "^5.4.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.7.5",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/schematics": "^10.1.0",
    "@types/node": "^20.14.0",
    "rimraf": "^5.0.0",
    "ts-loader": "^9.5.0",
    "typescript": "^5.5.0"
  }
}
