#############################################
# Recruitment CRM Platform - Environment Template
# Copy to .env and fill in real values.
# NEVER commit a real .env file.
#############################################

# ---------- General ----------
NODE_ENV=development
APP_NAME=recruitment-crm

# ---------- API (apps/api) ----------
API_PORT=4000
API_HOST=0.0.0.0
API_URL=http://localhost:4000
API_GLOBAL_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000

# ---------- Web (apps/web) ----------
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_REALTIME_URL=http://localhost:4001

# ---------- Realtime (apps/realtime) ----------
REALTIME_PORT=4001

# ---------- Worker (apps/worker) ----------
WORKER_CONCURRENCY=5

# ---------- PostgreSQL ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=recruitment_crm
POSTGRES_USER=crm_user
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://crm_user:changeme@localhost:5432/recruitment_crm?schema=public
# Separate pooled URL for serverless/edge-friendly connections (e.g. PgBouncer)
DATABASE_POOL_URL=postgresql://crm_user:changeme@localhost:6432/recruitment_crm?schema=public&pgbouncer=true

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# ---------- Auth ----------
JWT_ACCESS_SECRET=replace_with_random_64_char_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_random_64_char_secret
JWT_REFRESH_EXPIRES_IN=7d
SESSION_SECRET=replace_with_random_64_char_secret
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
PASSWORD_SALT_ROUNDS=12

# ---------- File Storage (S3-compatible: AWS S3 / Cloudflare R2 / MinIO) ----------
STORAGE_PROVIDER=s3
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=crm-documents
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_FORCE_PATH_STYLE=false
STORAGE_PUBLIC_URL=
STORAGE_MAX_UPLOAD_MB=25

# ---------- Email ----------
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Recruitment CRM <no-reply@example.com>"

# ---------- Rate limiting ----------
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120

# ---------- Observability ----------
LOG_LEVEL=info
LOG_FORMAT=json

# ---------- Feature flags / integrations (placeholders) ----------
CV_PARSING_ENABLED=false
