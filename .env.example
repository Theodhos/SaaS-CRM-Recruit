#############################################
# Recruitment CRM Platform - Environment Template
# Copy to .env and fill in real values.
# NEVER commit a real .env file.
#############################################

# ---------- General ----------
NODE_ENV=development
APP_NAME=recruitment-crm

# ---------- API (apps/api) ----------
API_PORT=4000
API_HOST=0.0.0.0
API_URL=http://localhost:4000
API_GLOBAL_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000
# Website origins allowed to call the public "apply" endpoint (docs/api/public-applications.md). Default: any.
PUBLIC_APPLICATIONS_ORIGINS=*

# ---------- Web (apps/web) ----------
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_REALTIME_URL=http://localhost:4001

# ---------- Realtime (apps/realtime) ----------
REALTIME_PORT=4001

# ---------- Worker (apps/worker) ----------
WORKER_CONCURRENCY=5

# ---------- PostgreSQL ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=recruitment_crm
POSTGRES_USER=crm_user
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://crm_user:changeme@localhost:5432/recruitment_crm?schema=public
# Separate pooled URL for serverless/edge-friendly connections (e.g. PgBouncer)
DATABASE_POOL_URL=postgresql://crm_user:changeme@localhost:6432/recruitment_crm?schema=public&pgbouncer=true

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# ---------- Auth ----------
JWT_ACCESS_SECRET=replace_with_random_64_char_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_random_64_char_secret
JWT_REFRESH_EXPIRES_IN=7d
SESSION_SECRET=replace_with_random_64_char_secret
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
PASSWORD_SALT_ROUNDS=12

# ---------- File Storage (S3-compatible: AWS S3 / Cloudflare R2 / MinIO) ----------
STORAGE_PROVIDER=s3
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=crm-documents
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_FORCE_PATH_STYLE=false
STORAGE_PUBLIC_URL=
STORAGE_MAX_UPLOAD_MB=25

# ---------- Email ----------
# Carries the login verification codes and the password reset links, so production needs a real provider.
# Any SMTP service works. Resend, for example:
#   SMTP_HOST=smtp.resend.com  SMTP_PORT=465  SMTP_USER=resend  SMTP_PASSWORD=<your Resend API key>
#   SMTP_FROM="Recruitment CRM <no-reply@your-verified-domain>"
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Recruitment CRM <no-reply@example.com>"

# ---------- Supabase (Auth: sends and checks the login verification code) ----------
SUPABASE_URL=
# Browser-safe only with Row Level Security on.
SUPABASE_ANON_KEY=
# Bypasses Row Level Security: API only, never in the web app, never committed.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Login verification code (e-mail OTP) ----------
# Per user, the admin switches the code on in the user form ("Ask for an e-mail code at sign-in").
# true here asks EVERY account for it — only once SMTP below delivers real e-mail, or nobody can sign in.
LOGIN_OTP_ENABLED=false
# How long a code is accepted. The verification page asks for the next code when it runs out, so codes rotate.
# E-mail often takes 5-30 seconds to arrive: raise this (e.g. 120) if people cannot type the code in time.
OTP_EXPIRATION_SECONDS=20
# Digits in a code, 6 to 10. With OTP_DELIVERY=supabase: the "Email OTP Length" set in the Supabase dashboard.
OTP_LENGTH=6
# Wrong tries a code takes before it is dead.
OTP_MAX_ATTEMPTS=5
# Seconds between two codes of one sign-in.
OTP_RESEND_COOLDOWN_SECONDS=20
# Codes one sign-in may send before the password has to be entered again.
OTP_MAX_CODES=15
# Who sends the code. smtp: the API makes it and e-mails it through SMTP below. supabase: Supabase Auth makes it,
# e-mails it and checks it (needs SUPABASE_URL + SUPABASE_ANON_KEY; in the Supabase dashboard the "Magic Link" and
# "Confirm signup" e-mail templates must contain {{ .Token }}; Supabase sends one e-mail per address per minute).
OTP_DELIVERY=smtp
# Key of the code hashes. Unset = JWT_ACCESS_SECRET.
OTP_SECRET=
# Development only: when no mail server is reachable, show the code on the verification page so sign-in still
# works. Ignored when NODE_ENV=production. Set to false to require real e-mail in development too.
OTP_DEV_FALLBACK=true

# ---------- Password reset ----------
# Where the web app lives: the "choose a new password" link in the e-mail points here. Unset = first CORS_ORIGINS.
WEB_URL=http://localhost:3000

# ---------- Rate limiting ----------
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120

# ---------- Observability ----------
LOG_LEVEL=info
LOG_FORMAT=json

# ---------- Feature flags / integrations (placeholders) ----------
CV_PARSING_ENABLED=false

# ---------- Zoom (interview links created from the pipeline) ----------
# Server-to-Server OAuth app (scope meeting:write). Unset = no meeting can be created from the pipeline.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# ---------- Telephony (Communication -> Phones, browser calling via Twilio Programmable Voice) ----------
# Unset = the Phones list works (import, search, history) but the Call button explains what is missing.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=
TWILIO_CALLER_ID=
# Verifies webhook signatures; set it in production.
TWILIO_AUTH_TOKEN=
# URL Twilio can reach this API on (TwiML app voice URL: <PUBLIC_API_URL>/api/v1/phones/calls/twiml).
PUBLIC_API_URL=
